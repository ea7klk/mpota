@startuml MPOTA_Data_Model
title MPOTA - logical data model

hide methods
hide stereotypes
skinparam shadowing false
skinparam backgroundColor #FAFBFC
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  ArrowColor #334155
  AttributeIconSize 0
}
skinparam enum {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
skinparam note {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}

package "Identity and authorization" {
  class User {
    +id: UUID <<PK>>
    +email: string <<unique>>
    +password_hash: string?
    +display_name: string
    +callsign: string?
    +locale: Locale
    +status: UserStatus
    +email_verified_at: datetime?
    +deactivated_at: datetime?
    +deleted_at: datetime?
    +created_at: datetime
  }

  class Role {
    +id: UUID <<PK>>
    +code: RoleCode <<unique>>
    +name: string
  }

  class UserRole {
    +user_id: UUID <<PK,FK>>
    +role_id: UUID <<PK,FK>>
    +granted_by: UUID <<FK>>
    +created_at: datetime
  }

  class ApprovalScope {
    +id: UUID <<PK>>
    +user_role_id: UUID <<FK>>
    +scope_type: ScopeType
    +all_countries: boolean
    +created_at: datetime
  }

  class ApprovalScopeCountry {
    +approval_scope_id: UUID <<PK,FK>>
    +country_iso2: string <<PK,FK>>
  }

  class ApprovalScopeContinent {
    +approval_scope_id: UUID <<PK,FK>>
    +continent_code: string <<PK,FK>>
  }

  User "1" -- "0..*" UserRole
  Role "1" -- "0..*" UserRole
  UserRole "1" -- "0..*" ApprovalScope
  ApprovalScope "1" -- "0..*" ApprovalScopeCountry
  ApprovalScope "1" -- "0..*" ApprovalScopeContinent
  User "0..*" -- "0..1" UserRole : granted_by
}

package "Reference catalog" {
  class Country {
    +iso2: string <<PK>>
    +iso3: string
    +name: string
    +continent_code: string
  }

  class Continent {
    +code: string <<PK>>
    +name: string
  }

  class Park {
    +id: UUID <<PK>>
    +reference: string <<unique>>
    +country_iso2: string <<FK>>
    +continent_code: string <<FK>>
    +region: string?
    +locality: string?
    +latitude: decimal(9,6)
    +longitude: decimal(9,6)
    +park_type: ParkType
    +status: ParkStatus
    +source_url: string?
    +access_notes: text?
    +photo_url: string?
    +approved_at: datetime?
    +approved_by: UUID <<FK>>
    +created_at: datetime
    +updated_at: datetime
  }

  class ParkTranslation {
    +park_id: UUID <<PK,FK>>
    +locale: Locale <<PK>>
    +name: string
    +description: text?
  }

  class ParkImage {
    +id: UUID <<PK>>
    +park_id: UUID <<FK>>
    +uploaded_by: UUID <<FK>>
    +image_number: integer
    +object_key: string <<unique>>
    +original_filename: string
    +content_type: string
    +size_bytes: integer
    +created_at: datetime
  }

  Continent "1" -- "0..*" Country
  Country "1" -- "0..*" Park
  Park "1" -- "0..*" ParkTranslation
  Park "1" -- "0..*" ParkImage
  User "1" -- "0..*" ParkImage : uploaded_by
  User "0..*" -- "0..1" Park : approved_by
  Country "1" -- "0..*" ApprovalScopeCountry
  Continent "1" -- "0..*" ApprovalScopeContinent
}

package "Proposal and moderation" {
  class ParkProposal {
    +id: UUID <<PK>>
    +submitted_by: UUID <<FK>>
    +country_iso2: string <<FK>>
    +continent_code: string <<FK>>
    +region: string?
    +locality: string?
    +latitude: decimal(9,6)
    +longitude: decimal(9,6)
    +park_type: ParkType
    +source_url: string?
    +access_notes: text?
    +photo_url: string?
    +status: ProposalStatus
    +review_notes: text?
    +reviewed_by: UUID <<FK>>
    +reviewed_at: datetime?
    +created_at: datetime
    +updated_at: datetime
  }

  class ProposalTranslation {
    +proposal_id: UUID <<PK,FK>>
    +locale: Locale <<PK>>
    +name: string
    +description: text?
  }

  class ModerationDecision {
    +id: UUID <<PK>>
    +proposal_id: UUID <<FK>>
    +decided_by: UUID <<FK>>
    +decision: ProposalStatus
    +notes: text?
    +created_at: datetime
  }

  User "1" -- "0..*" ParkProposal : submitted_by
  ParkProposal "1" -- "0..*" ProposalTranslation
  ParkProposal "1" -- "0..*" ModerationDecision
  User "1" -- "0..*" ModerationDecision : decided_by
  Country "1" -- "0..*" ParkProposal
}

package "Logging and outcomes" {
  class AdifUpload {
    +id: UUID <<PK>>
    +uploaded_by: UUID <<FK>>
    +object_key: string <<unique>>
    +original_filename: string
    +sha256: string
    +size_bytes: bigint
    +status: UploadStatus
    +parser_version: string?
    +error_count: integer
    +uploaded_at: datetime
    +processed_at: datetime?
  }

  class Logbook {
    +id: UUID <<PK>>
    +upload_id: UUID <<FK>>
    +owner_id: UUID <<FK>>
    +station_callsign: string
    +started_at: datetime?
    +ended_at: datetime?
    +status: LogStatus
  }

  class Contact {
    +id: UUID <<PK>>
    +logbook_id: UUID <<FK>>
    +park_id: UUID <<FK>>
    +qso_callsign: string
    +qso_datetime: datetime
    +band: string?
    +mode: string?
    +frequency: decimal?
    +rst_sent: string?
    +rst_received: string?
    +validity: ContactValidity
    +error_message: string?
  }

  class UserParkStat {
    +user_id: UUID <<PK,FK>>
    +park_id: UUID <<PK,FK>>
    +role: ParticipationRole <<PK>>
    +contact_count: integer
    +last_contact_at: datetime?
    +updated_at: datetime
  }

  User "1" -- "0..*" AdifUpload : uploaded_by
  AdifUpload "1" -- "0..1" Logbook
  User "1" -- "0..*" Logbook : owner_id
  Logbook "1" -- "0..*" Contact
  Park "1" -- "0..*" Contact
  User "1" -- "0..*" UserParkStat
  Park "1" -- "0..*" UserParkStat
}

package "Awards" {
  class Award {
    +id: UUID <<PK>>
    +key: string <<unique>>
    +status: AwardStatus
    +award_type: AwardType
    +created_by: UUID <<FK>>
    +published_by: UUID <<FK>>
    +created_at: datetime
    +published_at: datetime?
    +retired_at: datetime?
  }

  class AwardTranslation {
    +award_id: UUID <<PK,FK>>
    +locale: Locale <<PK>>
    +name: string
    +description: text?
  }

  class AwardVersion {
    +id: UUID <<PK>>
    +award_id: UUID <<FK>>
    +version_number: integer
    +valid_from: datetime?
    +valid_until: datetime?
    +created_at: datetime
  }

  class AwardRule {
    +id: UUID <<PK>>
    +award_version_id: UUID <<FK>>
    +rule_type: string
    +rule_definition: json
  }

  class AwardScopeCountry {
    +award_id: UUID <<PK,FK>>
    +country_iso2: string <<PK,FK>>
  }

  class AwardScopeContinent {
    +award_id: UUID <<PK,FK>>
    +continent_code: string <<PK,FK>>
  }

  class AwardProgress {
    +user_id: UUID <<PK,FK>>
    +award_id: UUID <<PK,FK>>
    +current_value: decimal
    +required_value: decimal
    +status: AwardProgressStatus
    +updated_at: datetime
  }

  class AwardGrant {
    +id: UUID <<PK>>
    +user_id: UUID <<FK>>
    +award_id: UUID <<FK>>
    +award_version_id: UUID <<FK>>
    +evidence_snapshot: json
    +granted_at: datetime
  }

  Award "1" -- "0..*" AwardTranslation
  Award "1" -- "0..*" AwardVersion
  AwardVersion "1" -- "0..*" AwardRule
  Award "1" -- "0..*" AwardScopeCountry
  Award "1" -- "0..*" AwardScopeContinent
  Country "1" -- "0..*" AwardScopeCountry
  Continent "1" -- "0..*" AwardScopeContinent
  User "1" -- "0..*" Award : created_by
  User "0..*" -- "0..1" Award : published_by
  User "1" -- "0..*" AwardProgress
  Award "1" -- "0..*" AwardProgress
  User "1" -- "0..*" AwardGrant
  Award "1" -- "0..*" AwardGrant
  AwardVersion "1" -- "0..*" AwardGrant
}

package "Operational audit" {
  class AuditEvent {
    +id: UUID <<PK>>
    +actor_id: UUID <<FK>>
    +action: string
    +entity_type: string
    +entity_id: UUID
    +before_json: json?
    +after_json: json?
    +request_id: string?
    +created_at: datetime
  }

  User "0..*" -- "0..1" AuditEvent : actor
}

enum Locale {
  en
  es
  fr
  de
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum RoleCode {
  MEMBER
  ENTITY_ADMIN
  AWARD_ADMIN
  GLOBAL_ADMIN
  SYSTEM_BOOTSTRAP_ADMIN
}

enum ScopeType {
  COUNTRY
  CONTINENT
  ALL
}

enum ParkType {
  MUNICIPAL_PARK
  URBAN_FOREST
  BOTANICAL_GARDEN
  RECREATION_AREA
  OTHER
}

enum ParkStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
  ARCHIVED
}

enum ProposalStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum UploadStatus {
  RECEIVED
  SCANNING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  QUARANTINED
}

enum LogStatus {
  PROCESSING
  VALID
  PARTIAL
  REJECTED
}

enum ContactValidity {
  VALID
  DUPLICATE
  INVALID_PARK
  INVALID_FIELD
  OUTSIDE_RULES
}

enum ParticipationRole {
  ACTIVATOR
  HUNTER
}

enum AwardStatus {
  DRAFT
  PENDING_PUBLICATION
  PUBLISHED
  RETIRED
}

enum AwardType {
  ACTIVATOR
  HUNTER
  COMBINED
}

enum AwardProgressStatus {
  IN_PROGRESS
  EARNED
}

note right of Park
  Reference invariant
  Park.reference is generated only inside the approval transaction:
  `MP` + uppercase Country.iso2 + `-` + LPAD(country sequence, 5, '0')
  Example: MPCS-00001
  The sequence is monotonic within a country and must be protected by
  a database unique constraint and transactional allocation.
end note

note left of Park
  Visibility invariant
  Public map, search, park-detail, and GeoJSON endpoints may return only
  Park.status = APPROVED. Authorization to see a pending proposal is a
  separate moderation-queue permission.
end note

note right of ApprovalScope
  Approval scope invariant
  An approver is eligible when:
  - an active ApprovalScope has all_countries = true; or
  - the proposal country_iso2 is in country_codes; or
  - the proposal continent_code is in continent_codes.
  ApprovalScopeCountry and ApprovalScopeContinent rows represent the
  multi-select UI values and are validated against ISO-3166 and the
  configured continent catalog. `all_countries = true` is the explicit
  global option.
end note

note right of Award
  Award governance invariant
  Award Admins may create and edit draft awards and their localized
  content. Global Admins publish, retire, or override awards. A published
  AwardVersion and its rules are immutable; new criteria require a new
  version. Award evaluation uses the version valid for the qualifying data.
end note

note bottom of Park
  PostGIS invariant
  Store a generated geometry(Point, 4326) from latitude/longitude for
  spatial indexes, duplicate-distance checks, bounding-box map queries,
  and future boundary validation. Cast to geography for geodesic distance
  calculations where needed.
end note

@enduml
