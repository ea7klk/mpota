NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mpota:mpota@localhost:5432/mpota
JWT_SECRET=replace-this-in-development
AUTH_MODE=local
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/mpota/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8081/realms/mpota
KEYCLOAK_AUDIENCE=mpota-api
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=mpota
VITE_API_URL=http://localhost:3000/api/v1
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional idempotent local bootstrap administrator. Keep the password in the
# ignored .env file or inject it from a secret; never commit it to Git.
BOOTSTRAP_ADMIN_EMAIL=volker@ea7klk.es
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-secret
BOOTSTRAP_ADMIN_NAME=Volker Kerkhoff
BOOTSTRAP_ADMIN_CALLSIGN=EA7KLK
BOOTSTRAP_ADMIN_LOCALE=en

# Optional self-hosted tile profile. The default development stack uses the
# public OSM tile endpoint above and does not download or import map data.
# Enable with: docker compose --profile self-hosted-tiles \
#   -f compose.yaml -f compose.self-hosted-tiles.yaml up --build
MPOTA_TILESET_URL=https://download.geofabrik.de/europe-latest.osm.pbf
MPOTA_TILESET_SOURCE_FILE=europe-latest.osm.pbf
MPOTA_TILESET_FILE=europe.mbtiles
MPOTA_TILESET_SHA256=
MPOTA_TILESET_REQUIRED=true
MPOTA_TILESET_FORCE_REFRESH=false
